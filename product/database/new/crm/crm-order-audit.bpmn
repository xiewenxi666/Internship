<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://flowable.org/bpmn">
  <process id="crm-order-audit" name="CRM订单审批" isExecutable="true">
    <startEvent id="start" name="开始" />
    <userTask id="initiatorTask" name="发起人" flowable:candidateStrategy="36">
      <extensionElements>
        <flowable:taskListener event="complete" class="com.meession.etm.module.bpm.framework.flowable.core.listener.BpmTaskInitiatorCompleteListener" />
      </extensionElements>
    </userTask>
    <userTask id="approveTask" name="审批" flowable:candidateStrategy="37" flowable:candidateParam="1" />
    <endEvent id="end" name="结束" />
    <sequenceFlow id="flow1" sourceRef="start" targetRef="initiatorTask" />
    <sequenceFlow id="flow2" sourceRef="initiatorTask" targetRef="approveTask" />
    <sequenceFlow id="flow3" sourceRef="approveTask" targetRef="end" />
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="crm-order-audit">
      <bpmndi:BPMNShape id="shapeStart" bpmnElement="start"><dc:Bounds x="60" y="200" width="30" height="30"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shapeInit" bpmnElement="initiatorTask"><dc:Bounds x="150" y="178" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shapeApprove" bpmnElement="approveTask"><dc:Bounds x="350" y="178" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shapeEnd" bpmnElement="end"><dc:Bounds x="550" y="200" width="30" height="30"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge1" bpmnElement="flow1"><di:waypoint x="90" y="215"/><di:waypoint x="150" y="218"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge2" bpmnElement="flow2"><di:waypoint x="250" y="218"/><di:waypoint x="350" y="218"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge3" bpmnElement="flow3"><di:waypoint x="450" y="218"/><di:waypoint x="550" y="215"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>